{
  "expo": {
    "name": "Minute",
    "slug": "MiniGranola",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "minigranola",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.kamfal.minigranola",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B3FE0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Minute utilise le micro pour enregistrer vos réunions et conversations.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 1
          }
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
